{
  "name": "softwareske/samomind-ai-assistant",
  "description": "SamoMind AI Assistant WordPress plugin. Composer is used for development tooling only.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "wordpress/plugin-check",
        "version": "2.1.0",
        "type": "phpcodesniffer-standard",
        "description": "Static phpcs rules of the WordPress.org Plugin Check tool (not on Packagist).",
        "dist": {
          "url": "https://github.com/WordPress/plugin-check/archive/refs/tags/2.1.0.zip",
          "type": "zip"
        }
      }
    }
  ],
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wordpress/plugin-check": "2.1.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "compat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- --extensions=php --ignore=vendor/*,tests/* .",
    "test": "phpunit",
    "check": [
      "@lint",
      "@compat",
      "@plugin-check",
      "@test"
    ],
    "smoke": "sh tests/smoke/wp-env-smoke.sh",
    "plugin-check": "phpcs --standard=phpcs-plugin-check.xml.dist"
  }
}
