{
  "name": "softwareske/samomind-ai-assistant",
  "description": "SamoMind AI Assistant WordPress plugin. Composer is used for development tooling only.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6"
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "compat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- --extensions=php --ignore=vendor/*,tests/* .",
    "test": "phpunit",
    "check": [
      "@lint",
      "@compat",
      "@test"
    ],
    "smoke": "sh tests/smoke/wp-env-smoke.sh"
  }
}
